# 필수
OPENAI_API_KEY=sk-your-api-key

# Raspberry Pi ALSA 장치
ALSA_MIC_DEVICE=plughw:CARD=Device,DEV=0
ALSA_SPEAKER_DEVICE=plughw:CARD=Audio,DEV=0

# 녹음 형식 (기본: 16kHz, 16비트, 모노)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_FORMAT=S16_LE

# 필요할 때 모델/음성을 교체할 수 있습니다.
OPENAI_LLM_MODEL=gpt-5.6-luna
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
MAX_HISTORY_TURNS=12

# 토론·인물 인터뷰 학습자료(Supabase 공개 anon 키)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
